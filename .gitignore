# Claude — ignore session/cache/local artifacts, but commit project-wide settings
.claude/*
!.claude/settings.json

# relay — per-feature worktrees (ephemeral)
.worktrees/

# node / build
node_modules/
dist/
coverage/

# cloudflare local state (D1 sqlite, deploy redirect, workerd cache)
.wrangler/

# local secrets (dotenv syntax) — never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# NOTE: worker-configuration.d.ts is deliberately NOT ignored.
# `npm run check` uses `wrangler types --check`, which validates the committed
# file against wrangler.jsonc without rewriting it. Regenerate with
# `npm run cf-typegen` whenever wrangler.jsonc changes, and commit the result.

# relay — per-attempt cumulative diffs (whole branch vs base). Exactly
# reproducible with `git diff <base>..<commit>` once the work is committed, and
# they nest inside each other (15 MB for one feature), so they stay local. The
# per-attempt `diff.implementer.patch` slices are NOT reproducible from git and
# ARE committed.
PRPs/reports/**/attempts/*/diff.patch

# Playwright MCP session output (console logs, page snapshots, screenshots)
# written into the repo root by the browser tooling — ephemeral, per-session
.playwright-mcp/

# A one-off 1.7 MB minified bundle pulled from github.com while debugging why
# GitHub failed to render the README's mermaid diagram (2026-09-01, commits
# a3e0180..900d078). Not project code, not a dependency — vendor output that
# happened to land in the repo root. Safe to delete at any time.
/mermaidMarkdown.js
