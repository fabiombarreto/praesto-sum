+            }
+          >
+            <Chip value="high">Alta</Chip>
+            <Chip value="normal">Normal</Chip>
+            <Chip value="low">Baixa</Chip>
+          </ChipGroup>
+        </div>
+
+        <div className="flex flex-col gap-1">
